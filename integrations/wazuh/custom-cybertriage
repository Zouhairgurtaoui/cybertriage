#!/usr/bin/env python3

import http.client
import sys
import time
from pathlib import Path


TOKEN_FILE = Path("/var/ossec/etc/cybertriage-ingest.token")
ENDPOINT = "/api/v1/alerts/wazuh"
EXPECTED_URL = f"http://127.0.0.1:18000{ENDPOINT}"

MAX_ALERT_BYTES = 262_144
MAX_ATTEMPTS = 3
RETRYABLE_STATUSES = {408, 429, 500, 502, 503, 504}


class ForwardingError(RuntimeError):
    """An alert could not be delivered to CyberTriage."""


def read_token() -> str:
    with TOKEN_FILE.open("rb") as file:
        raw = file.read(514)

    try:
        token = raw.decode("ascii").strip()
    except UnicodeDecodeError:
        raise ForwardingError("The ingestion token must be ASCII.") from None

    if not 32 <= len(token) <= 512 or any(
        character.isspace() for character in token
    ):
        raise ForwardingError("The ingestion token is invalid.")

    return token


def read_alert(path: Path) -> bytes:
    with path.open("rb") as file:
        payload = file.read(MAX_ALERT_BYTES + 1)

    if not payload:
        raise ForwardingError("The alert file is empty.")

    if len(payload) > MAX_ALERT_BYTES:
        raise ForwardingError("The alert exceeds the ingestion size limit.")

    return payload


def forward_alert(payload: bytes, token: str) -> None:
    failure = "Connection to CyberTriage failed."

    for attempt in range(MAX_ATTEMPTS):
        connection = http.client.HTTPConnection(
            "127.0.0.1",
            18000,
            timeout=10,
        )

        try:
            connection.request(
                "POST",
                ENDPOINT,
                body=payload,
                headers={
                    "Content-Type": "application/json",
                    "Authorization": f"Bearer {token}",
                },
            )

            response = connection.getresponse()

            if response.status in {200, 201}:
                return

            failure = f"CyberTriage returned HTTP {response.status}."

            if response.status not in RETRYABLE_STATUSES:
                raise ForwardingError(failure)

        except (OSError, http.client.HTTPException):
            failure = "Connection to CyberTriage failed."

        finally:
            connection.close()

        if attempt < MAX_ATTEMPTS - 1:
            time.sleep(2**attempt)

    raise ForwardingError(failure)


def main() -> int:
    try:
        if len(sys.argv) < 4:
            raise ForwardingError("Missing Wazuh integration arguments.")

        if sys.argv[3] != EXPECTED_URL:
            raise ForwardingError(
                "The webhook must use the configured SSH tunnel endpoint."
            )

        payload = read_alert(Path(sys.argv[1]))
        token = read_token()
        forward_alert(payload, token)

    except (ForwardingError, OSError) as error:
        # Do not print the token, raw alert, or server response body.
        message = (
            str(error)
            if isinstance(error, ForwardingError)
            else "Unable to read the integration files."
        )
        print(f"CyberTriage forwarding failed: {message}", file=sys.stderr)
        return 1

    print("CyberTriage accepted the alert.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())