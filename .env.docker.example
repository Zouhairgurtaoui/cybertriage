# Copy to .env.docker.local and pass --env-file .env.docker.local to Compose.
# Use forward slashes for Windows bind-mount paths.
CYBERTRIAGE_NODE_IMAGE=node:26-slim
# Existing Ollama runs outside this Compose project.
CYBERTRIAGE_OLLAMA_URL=http://host.docker.internal:11434
CYBERTRIAGE_MODEL=qwen3:4b-instruct
CYBERTRIAGE_MODEL_TIMEOUT_SECONDS=600
CYBERTRIAGE_WEB_PORT=5173
CYBERTRIAGE_INGEST_PORT=8000

CYBERTRIAGE_ANALYSTS_CONFIG=./config/analysts.local.yaml
CYBERTRIAGE_RESPONSE_CONFIG=./config/response_actions.yaml
CYBERTRIAGE_FIREWALLS_CONFIG=./config/firewalls.yaml
CYBERTRIAGE_INGEST_TOKEN_PATH=./config/secrets/ingestion.token
CYBERTRIAGE_INDEXER_PASSWORD_PATH=./config/secrets/indexer.password
CYBERTRIAGE_INDEXER_CA_PATH=./config/certs/indexer-ca.pem

# Must be reachable from a container and match the Indexer certificate's SAN.
# host.docker.internal reaches the Windows host; localhost means the container.
CYBERTRIAGE_INDEXER_URL=https://REPLACE_WITH_CERTIFICATE_MATCHING_HOST:9200
CYBERTRIAGE_INDEXER_USERNAME=REPLACE_WITH_READ_ONLY_USERNAME

# Optional existing Windows SSH forward. Preserve the Indexer certificate's
# loopback identity by setting INDEXER_URL=https://127.0.0.1:19200 and enabling:
# CYBERTRIAGE_INDEXER_FORWARD_HOST=host.docker.internal
# CYBERTRIAGE_INDEXER_FORWARD_PORT=19200
CYBERTRIAGE_INDEXER_FORWARD_HOST=
CYBERTRIAGE_INDEXER_FORWARD_PORT=

# Used only with --profile graph. Graph processes share Neo4j's loopback network.
CYBERTRIAGE_NEO4J_IMAGE=neo4j:5.26-community
CYBERTRIAGE_GRAPH_NAMESPACE=cybertriage-docker
CYBERTRIAGE_NEO4J_PASSWORD_PATH=./config/secrets/neo4j.password
